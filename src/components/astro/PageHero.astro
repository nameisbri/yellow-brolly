---
interface Props {
  headline: string;
  subhead?: string;
  eyebrow?: string;
}

const { headline, subhead, eyebrow } = Astro.props;
---

<section class="relative pt-32 pb-20 md:pt-44 md:pb-28 lg:pt-52 lg:pb-36 bg-yellow-primary overflow-hidden">
  <!-- Subtle dot pattern -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, #000 1px, transparent 0); background-size: 24px 24px;"></div>

  <!-- Large decorative umbrella watermark -->
  <div class="absolute -right-16 md:-right-8 top-1/2 -translate-y-1/2 opacity-[0.06] pointer-events-none select-none">
    <svg width="400" height="400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" class="w-64 h-64 md:w-80 md:h-80 lg:w-[400px] lg:h-[400px] text-black">
      <path d="M23 12a11.05 11.05 0 0 0-22 0zm-5 7a3 3 0 0 1-6 0v-7" />
    </svg>
  </div>

  <!-- Diagonal accent line -->
  <div class="absolute top-0 right-0 w-px h-full bg-gradient-to-b from-black/10 via-black/5 to-transparent origin-top-right rotate-[15deg] translate-x-[-30vw] hidden lg:block pointer-events-none"></div>

  <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl relative z-10">
    {eyebrow && (
      <div class="scroll-fade-up mb-6 md:mb-8">
        <span class="inline-block text-black/60 text-sm font-semibold tracking-[0.3em] uppercase">{eyebrow}</span>
        <div class="mt-3 w-12 h-[2px] bg-black/20"></div>
      </div>
    )}
    <h1 class="scroll-fade-up text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-display font-bold text-black leading-[1.05] tracking-tight max-w-5xl">
      {headline}
    </h1>
    {subhead && (
      <p class="scroll-fade-up mt-6 md:mt-8 text-lg md:text-xl text-black/70 max-w-2xl leading-relaxed">
        {subhead}
      </p>
    )}
  </div>

  <!-- Bottom edge treatment -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-cream to-transparent pointer-events-none"></div>
</section>
