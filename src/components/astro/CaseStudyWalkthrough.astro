---
interface BeforeData {
  tools?: string;
  timeLost?: string;
  adoption?: string;
  security?: string;
  chaos?: string;
  processes?: string;
  onboarding?: string;
  training?: string;
  systems?: string;
}

interface AfterData {
  tools?: string;
  timeSaved?: string;
  adoption?: string;
  security?: string;
  roadmap?: string;
  chaos?: string;
  processes?: string;
  onboarding?: string;
  training?: string;
  systems?: string;
}

interface Props {
  title: string;
  clientType: string;
  sectorPainPoint?: string;
  challenge: string;
  solution: string;
  outcome: string;
  before?: BeforeData;
  after?: AfterData;
  metrics?: string[];
  quote?: string;
  quoteAuthor?: string;
  quoteRole?: string;
  image: string;
  imageAlt: string;
  number: string;
  sectionId: string;
  accent: 'teal' | 'amber' | 'sage';
  nextProject?: { title: string; id: string; number: string };
}

const {
  title,
  clientType,
  sectorPainPoint,
  challenge,
  solution,
  outcome,
  before,
  after,
  metrics,
  quote,
  quoteAuthor,
  quoteRole,
  image,
  imageAlt,
  number,
  sectionId,
  accent,
  nextProject,
} = Astro.props;

const accentColors: Record<string, { hex: string; hexLight: string }> = {
  teal: { hex: '#6B9E9E', hexLight: '#6B9E9E18' },
  amber: { hex: '#C4956A', hexLight: '#C4956A18' },
  sage: { hex: '#7A9E7A', hexLight: '#7A9E7A18' },
};

const colors = accentColors[accent] || accentColors.teal;

// Extract before/after entries
function extractEntries(obj: Record<string, string | undefined> | undefined): [string, string][] {
  if (!obj) return [];
  return Object.entries(obj)
    .filter(([, v]) => v !== undefined)
    .map(([k, v]) => {
      const label = k
        .replace(/([A-Z])/g, ' $1')
        .replace(/^./, (s) => s.toUpperCase())
        .trim();
      return [label, v as string];
    });
}

const beforeEntries = extractEntries(before as Record<string, string | undefined>);
const afterEntries = extractEntries(after as Record<string, string | undefined>);

// Parse metrics
function parseMetric(metric: string): { number: string; label: string } {
  const match = metric.match(/^([\d]+%?)/);
  if (match) {
    return { number: match[1], label: metric.replace(match[1], '').trim() };
  }
  const wordNumMatch = metric.match(/^(Zero|Full|100%|One|Two|Three)/i);
  if (wordNumMatch) {
    return { number: wordNumMatch[1], label: metric.replace(wordNumMatch[1], '').trim() };
  }
  return { number: '', label: metric };
}
---

<section id={sectionId} class="relative">

  <!-- ==================== PROJECT HEADER ==================== -->
  <div class="relative bg-cream pt-20 md:pt-28 lg:pt-32 pb-12 md:pb-16 overflow-hidden">
    <!-- Large watermark number -->
    <div class="absolute top-1/2 right-0 -translate-y-1/2 translate-x-[10%] pointer-events-none select-none" aria-hidden="true">
      <span
        class="block text-[14rem] md:text-[20rem] lg:text-[26rem] font-display font-bold leading-none"
        style={`color: ${colors.hexLight}`}
      >
        {number}
      </span>
    </div>

    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl relative z-10">
      <div class="scroll-fade-up">
        <!-- Project label -->
        <div class="flex items-center gap-4 mb-6">
          <span class="text-xs md:text-sm font-bold tracking-[0.2em] uppercase" style={`color: ${colors.hex}`}>
            Project {number}
          </span>
          <span class="w-10 h-[2px]" style={`background: ${colors.hex}`}></span>
          <span class="text-xs md:text-sm text-text-muted tracking-wide">{clientType}</span>
        </div>

        <!-- Title -->
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-display font-bold text-text-primary leading-[1.1] tracking-tight max-w-4xl">
          {title}
        </h2>

        <!-- Challenge quote -->
        {sectorPainPoint && (
          <blockquote class="mt-8 md:mt-10 max-w-3xl pl-5 md:pl-6" style={`border-left: 3px solid ${colors.hex}`}>
            <p class="text-base md:text-lg text-text-secondary leading-relaxed italic">
              {sectorPainPoint}
            </p>
          </blockquote>
        )}
      </div>
    </div>
  </div>

  <!-- ==================== FULL-WIDTH IMAGE ==================== -->
  <div class="relative h-56 md:h-72 lg:h-96 overflow-hidden">
    <img
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover"
      loading="lazy"
    />
    <!-- Subtle accent tint -->
    <div class="absolute inset-0" style={`background: linear-gradient(135deg, ${colors.hex}12, transparent 60%)`}></div>
    <div class="absolute inset-0 bg-gradient-to-t from-cream-warm/60 via-transparent to-cream/30"></div>
  </div>

  <!-- ==================== CHALLENGE & SOLUTION ==================== -->
  <div class="bg-cream-warm py-14 md:py-20">
    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
      <div class="scroll-fade-up grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-20 max-w-5xl">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-4" style={`color: ${colors.hex}`}>
            The Challenge
          </h3>
          <p class="text-lg text-text-primary leading-relaxed">{challenge}</p>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-4" style={`color: ${colors.hex}`}>
            The Solution
          </h3>
          <p class="text-lg text-text-primary leading-relaxed">{solution}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== BEFORE / AFTER ==================== -->
  {before && after && (
    <div class="bg-cream-warm pb-14 md:pb-20">
      <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
        <div class="scroll-fade-up max-w-5xl">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-0 relative">
            <!-- Desktop center divider -->
            <div class="hidden md:flex absolute top-0 bottom-0 left-1/2 -translate-x-1/2 flex-col items-center" aria-hidden="true">
              <div class="flex-1 w-px bg-gradient-to-b from-transparent via-light-border to-transparent"></div>
              <div
                class="my-3 w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0"
                style={`background: ${colors.hex}`}
              >
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
              <div class="flex-1 w-px bg-gradient-to-b from-transparent via-light-border to-transparent"></div>
            </div>

            <!-- Before column -->
            <div class="pr-0 md:pr-12 lg:pr-16 pb-8 md:pb-0">
              <div class="flex items-center gap-3 mb-5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
                <h4 class="text-xs font-bold text-red-500/80 uppercase tracking-[0.15em]">Before</h4>
              </div>
              <ul class="space-y-4">
                {beforeEntries.map(([label, value]) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-red-400/50"></span>
                    <div>
                      <span class="text-xs text-text-muted uppercase tracking-wider block mb-0.5">{label}</span>
                      <span class="text-[0.95rem] text-text-secondary leading-snug">{value}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Mobile divider -->
            <div class="md:hidden flex items-center gap-4 py-4 mb-4" aria-hidden="true">
              <div class="flex-1 h-px" style={`background: linear-gradient(to right, transparent, ${colors.hex}40)`}></div>
              <div class="w-8 h-8 rounded-full flex items-center justify-center" style={`background: ${colors.hex}`}>
                <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
              <div class="flex-1 h-px" style={`background: linear-gradient(to left, transparent, ${colors.hex}40)`}></div>
            </div>

            <!-- After column -->
            <div class="pl-0 md:pl-12 lg:pl-16">
              <div class="flex items-center gap-3 mb-5">
                <span class="w-2.5 h-2.5 rounded-full" style={`background: ${colors.hex}`}></span>
                <h4 class="text-xs font-bold uppercase tracking-[0.15em]" style={`color: ${colors.hex}`}>After</h4>
              </div>
              <ul class="space-y-4">
                {afterEntries.map(([label, value]) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2 flex-shrink-0 w-1.5 h-1.5 rounded-full" style={`background: ${colors.hex}`}></span>
                    <div>
                      <span class="text-xs text-text-muted uppercase tracking-wider block mb-0.5">{label}</span>
                      <span class="text-[0.95rem] text-text-primary font-medium leading-snug">{value}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- ==================== KEY METRICS ==================== -->
  {metrics && metrics.length > 0 && (
    <div class="bg-cream py-14 md:py-20">
      <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
        <div class="scroll-fade-up max-w-5xl mx-auto">
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] mb-10 text-center" style={`color: ${colors.hex}`}>
            Key Results
          </h3>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-0">
            {metrics.map((metric, i) => {
              const parsed = parseMetric(metric);
              return (
                <Fragment>
                  {i > 0 && (
                    <div class="hidden sm:block w-px h-16 bg-light-border mx-8 md:mx-12 flex-shrink-0" aria-hidden="true"></div>
                  )}
                  {i > 0 && (
                    <div class="sm:hidden w-12 h-px bg-light-border" aria-hidden="true"></div>
                  )}
                  <div class="text-center flex-1">
                    {parsed.number ? (
                      <Fragment>
                        <div
                          class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-1.5 leading-none"
                          style={`color: ${colors.hex}`}
                        >
                          {parsed.number}
                        </div>
                        <div class="text-sm md:text-base text-text-muted">
                          {parsed.label}
                        </div>
                      </Fragment>
                    ) : (
                      <div class="text-xl md:text-2xl font-bold" style={`color: ${colors.hex}`}>
                        {parsed.label}
                      </div>
                    )}
                  </div>
                </Fragment>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- ==================== CLIENT QUOTE ==================== -->
  {quote && (
    <div class="bg-cream py-12 md:py-20">
      <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
        <div class="scroll-fade-up max-w-3xl mx-auto text-center">
          <div class="relative">
            <!-- Accent line -->
            <div class="w-10 h-[2px] mx-auto mb-8" style={`background: ${colors.hex}`}></div>
            <blockquote>
              <p class="text-xl md:text-2xl leading-relaxed text-text-secondary font-light italic">
                "{quote}"
              </p>
              {quoteAuthor && (
                <footer class="mt-8 flex items-center justify-center gap-3">
                  <div
                    class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0"
                    style={`background: ${colors.hex}`}
                  >
                    {quoteAuthor.charAt(0)}
                  </div>
                  <div class="text-left">
                    <cite class="not-italic font-semibold block text-text-primary text-base">
                      {quoteAuthor}
                    </cite>
                    {quoteRole && (
                      <p class="text-sm text-text-muted">{quoteRole}</p>
                    )}
                  </div>
                </footer>
              )}
            </blockquote>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- ==================== NEXT PROJECT LINK ==================== -->
  {nextProject ? (
    <div class="border-t border-light-border bg-cream-warm">
      <a href={`#${nextProject.id}`} class="group block">
        <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl py-8 md:py-10 flex items-center justify-between">
          <div>
            <span class="text-xs text-text-muted uppercase tracking-[0.15em] font-semibold">Next Project</span>
            <div class="text-lg md:text-2xl font-display font-bold text-text-primary group-hover:text-yellow-text transition-colors mt-1">
              <span class="text-text-muted/40 mr-2">{nextProject.number}</span>
              {nextProject.title}
            </div>
          </div>
          <svg class="w-6 h-6 md:w-8 md:h-8 text-text-muted/40 group-hover:text-yellow-text group-hover:translate-x-2 transition-all flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>
  ) : (
    <!-- Final project — thicker bottom divider -->
    <div class="h-px bg-gradient-to-r from-transparent via-light-border to-transparent"></div>
  )}

</section>
