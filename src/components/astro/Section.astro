---
interface Props {
  background?: 'black' | 'dark' | 'elevated' | 'warm' | 'warmer' | 'light';
  id?: string;
  class?: string;
  fullWidth?: boolean;
  noPadding?: boolean;
}

const {
  background = 'black',
  id,
  class: className = '',
  fullWidth = false,
  noPadding = false,
} = Astro.props;

const bgMap: Record<string, string> = {
  black: 'bg-black',
  dark: 'bg-dark',
  elevated: 'bg-dark-elevated',
  warm: 'bg-dark-warm',
  warmer: 'bg-dark-warmer',
  light: 'bg-dark-light',
};
---

<section id={id} class:list={[noPadding ? '' : 'py-16 md:py-24 lg:py-32', bgMap[background], className]}>
  {fullWidth ? <slot /> : (
    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
      <slot />
    </div>
  )}
</section>
