---
interface Props {
  background?: 'cream' | 'sand' | 'sand-dark' | 'warm' | 'dark' | 'black';
  id?: string;
  class?: string;
  fullWidth?: boolean;
  noPadding?: boolean;
}

const {
  background = 'cream',
  id,
  class: className = '',
  fullWidth = false,
  noPadding = false,
} = Astro.props;

const bgMap: Record<string, string> = {
  cream: 'bg-cream',
  sand: 'bg-sand',
  'sand-dark': 'bg-sand-dark',
  warm: 'bg-cream-warm',
  dark: 'bg-dark',
  black: 'bg-black',
};

const textClass = 'text-text-primary';
---

<section id={id} class:list={[noPadding ? '' : 'py-16 md:py-24 lg:py-32', bgMap[background], textClass, className]}>
  {fullWidth ? <slot /> : (
    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
      <slot />
    </div>
  )}
</section>
