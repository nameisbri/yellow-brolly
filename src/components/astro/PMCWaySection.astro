---
import Section from './Section.astro';
import { siteContent } from '../../data/content';

const { pmcSection } = siteContent.home;
---

<Section background="warm" class="py-12 md:py-16 lg:py-20">
  <div class="scroll-fade-up max-w-3xl">
    <span class="inline-block px-3 py-1 text-xs sm:text-sm font-medium bg-yellow-primary/10 text-yellow-primary mb-5 tracking-wider uppercase rounded-full">
      {pmcSection.subhead}
    </span>
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-white mb-6">
      {pmcSection.headline}
    </h2>
    <p class="text-base md:text-lg lg:text-xl text-gray leading-relaxed border-l-4 border-yellow-primary pl-4">
      {pmcSection.description}
    </p>
  </div>
</Section>
