---
import Section from './Section.astro';
import { siteContent } from '../../data/content';

const { pmcSection } = siteContent.home;
---

<Section background="cream" class="py-12 md:py-16 lg:py-20">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div class="scroll-fade-up">
      <span class="inline-block px-3 py-1 text-xs sm:text-sm font-medium bg-yellow-primary/10 text-yellow-text mb-5 tracking-wider uppercase rounded-full">
        {pmcSection.subhead}
      </span>
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-text-primary mb-6">
        {pmcSection.headline}
      </h2>
      <p class="text-base md:text-lg lg:text-xl text-text-muted leading-relaxed border-l-4 border-yellow-primary pl-4">
        {pmcSection.description}
      </p>
    </div>

    <!-- People-forward imagery -->
    <div class="scroll-fade-up relative hidden lg:block">
      <img
        src="/images/photos/homepage-pmc.jpg"
        alt="Group of colleagues gathered around a café table sharing a moment"
        class="w-full rounded-2xl aspect-[4/3] object-cover"
        loading="lazy"
      />
      <!-- Brand illustration accent -->
      <img
        src="/images/brand/winged-pencil.png"
        alt=""
        aria-hidden="true"
        class="absolute -top-16 -left-16 w-64 h-64 object-contain"
        style="filter: drop-shadow(0 0 8px rgba(255,252,247,0.95)) drop-shadow(0 0 16px rgba(255,252,247,0.8)) drop-shadow(0 0 28px rgba(255,252,247,0.6))"
        loading="lazy"
      />
    </div>
  </div>
</Section>
