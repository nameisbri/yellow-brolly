---
import Section from './Section.astro';
import { siteContent } from '../../data/content';
import { getCMSContent, cms } from '../../lib/cms';

const c = await getCMSContent();
const { values } = siteContent.about;

const iconSvgs: Record<string, string> = {
  clarity: '<circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" />',
  people: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />',
  secure: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />',
  purpose: '<circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />',
};
---

<Section background="sand">
  <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-12">
    {cms(c, 'about_values_heading', 'Our Core Values')}
  </h2>

  <div class="scroll-fade-up grid grid-cols-1 md:grid-cols-2 gap-x-6 md:gap-x-8 lg:gap-x-12 gap-y-8 md:gap-y-10">
    {values.map((value) => (
      <div class="group">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-full bg-yellow-primary/10 flex items-center justify-center text-yellow-primary group-hover:bg-yellow-primary/20 transition-colors duration-300">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvgs[value.icon] || iconSvgs['clarity']} />
          </div>
          <h3 class="text-lg font-bold text-text-primary">
            {value.title}
          </h3>
        </div>
        <p class="text-text-muted leading-relaxed">{value.description}</p>
      </div>
    ))}
  </div>
</Section>
