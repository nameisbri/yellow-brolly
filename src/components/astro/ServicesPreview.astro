---
import Section from './Section.astro';
import { siteContent } from '../../data/content';

const { servicesPreview } = siteContent.home;

const pillarAccentColors: Record<string, string> = {
  tools: 'var(--color-accent-teal)',
  culture: 'var(--color-accent-amber)',
  security: 'var(--color-accent-sage)',
  ai: 'var(--color-accent-mauve)',
};

const iconSvgs: Record<string, string> = {
  tools: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />',
  culture: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />',
  security: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" />',
  ai: '<path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z" /><path d="M7.5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" /><path d="M16.5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" />',
};
---

<Section background="black">
  <div class="scroll-fade-up mb-16 md:mb-20 text-center">
    <span class="inline-block text-yellow-primary text-sm font-semibold tracking-[0.2em] uppercase mb-4">Services</span>
    <h2 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-white mb-6 leading-[1.1] tracking-tight">What We Do</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
    {servicesPreview.map((service) => (
      <div class="scroll-fade-up group relative bg-dark-elevated border border-dark-border rounded-2xl p-6 md:p-8 hover:border-yellow-primary/30 transition-all duration-300 overflow-hidden hover:-translate-y-2">
        <div class="absolute top-0 left-0 w-full h-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`background: ${pillarAccentColors[service.icon]}`}></div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full flex items-center justify-center" style={`background: ${pillarAccentColors[service.icon]}20; color: ${pillarAccentColors[service.icon]}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvgs[service.icon] || iconSvgs['tools']} />
          </div>
          <h3 class="text-lg font-bold text-white">{service.title}</h3>
        </div>
        <p class="text-gray text-sm leading-relaxed">{service.description}</p>
      </div>
    ))}
  </div>

  <div class="mt-16 text-center">
    <a href="/services" class="relative inline-flex items-center justify-center font-semibold uppercase tracking-wider transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-yellow-primary focus-visible:ring-offset-2 focus-visible:ring-offset-black overflow-hidden group bg-transparent border-2 border-yellow-primary text-yellow-primary hover:bg-yellow-primary hover:text-black px-10 py-4 text-sm">
      <span class="relative z-10 flex items-center gap-2">
        Explore All Services
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
      </span>
      <span class="absolute inset-0 bg-yellow-primary translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
    </a>
  </div>
</Section>
