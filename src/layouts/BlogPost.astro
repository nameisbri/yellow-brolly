---
import Base from './Base.astro';

interface Props {
  title: string;
  excerpt: string;
  date: string;
  category: string;
}

const { title, excerpt, date, category } = Astro.props;
---

<Base title={`${title} | YellowBrollyCo`} description={excerpt}>
  <article class="pt-24 pb-16 md:pt-36 md:pb-20 lg:pt-48 lg:pb-32 bg-cream">
    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-3xl">
      <span class="inline-block text-yellow-text text-sm font-semibold tracking-[0.3em] uppercase mb-4">{category}</span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-text-primary mb-4">{title}</h1>
      <time class="text-text-muted text-sm">{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>

      <div class="mt-12 prose prose-yellow max-w-none text-text-muted leading-relaxed [&_h2]:text-text-primary [&_h2]:font-display [&_h2]:font-bold [&_h3]:text-text-primary [&_h3]:font-display [&_a]:text-yellow-text">
        <slot />
      </div>
    </div>
  </article>
</Base>
