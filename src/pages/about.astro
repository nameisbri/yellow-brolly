---
import Base from '../layouts/Base.astro';
import PageHero from '../components/astro/PageHero.astro';
import Section from '../components/astro/Section.astro';
import ValuesGrid from '../components/astro/ValuesGrid.astro';
import TeamSection from '../components/react/sections/TeamSection.tsx';
import CTASection from '../components/react/sections/CTASection.tsx';
import { siteContent } from '../data/content';
import { getCMSContent, cms } from '../lib/cms';

const c = await getCMSContent();
const { story, pmcWay, cta } = siteContent.about;
---

<Base
  title="About Us: Our Story & Team | YellowBrollyCo"
  description="Meet the YellowBrolly team. We bring together strategy, culture, digital readiness, brand, and implementation to help organizations grow."
>
  <PageHero headline={cms(c, 'about_headline', 'Tech with soul. Strategy with impact.')} subhead={cms(c, 'about_mission', 'Helping people-first organizations do well in a digital world, without compromising on security, strategy, or staying power.')} eyebrow="About Us" />

  <!-- Story with full-width photo -->
  <Section background="cream">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="scroll-fade-up">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-6">{cms(c, 'about_story_headline', 'Our Story')}</h2>
        <p class="text-lg text-text-muted leading-relaxed">{cms(c, 'about_story_content', "YellowBrollyCo started because we kept seeing the same problem: teams adopting powerful digital tools and losing their identity in the process. We spent years in consulting and branding, watching organizations struggle with technology that didn't match their values. So we built YellowBrolly to close that gap, combining strategic rigor with creative empathy, grounded in People Matter Culture.")}</p>
      </div>
      <div class="scroll-fade-up relative flex items-center justify-center">
        <img
          src="/images/brand/creative-designer.webp"
          alt=""
          aria-hidden="true"
          class="w-64 h-64 md:w-80 md:h-80 object-contain"
          loading="lazy"
        />
      </div>
    </div>
  </Section>

  <ValuesGrid />

  <!-- PMC Way with culture photo -->
  <Section background="dark">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="scroll-fade-up order-2 lg:order-1 relative">
        <img
          src="/images/photos/our-story-hero.webp"
          alt="Small team collaborating around a table, seen through a glass partition"
          class="w-full rounded-xl aspect-[4/3] object-cover"
          loading="lazy"
        />
        <img
          src="/images/brand/thumbs-up.webp"
          alt=""
          aria-hidden="true"
          class="absolute -top-12 -right-12 w-52 h-52 object-contain hidden lg:block"
          style="filter: drop-shadow(0 0 8px rgba(28,25,23,0.95)) drop-shadow(0 0 16px rgba(28,25,23,0.8)) drop-shadow(0 0 28px rgba(28,25,23,0.6))"
          loading="lazy"
        />
      </div>
      <div class="scroll-fade-up order-1 lg:order-2">
        {pmcWay.subhead && (
          <span class="inline-block px-3 py-1 text-sm font-medium bg-yellow-primary/20 text-yellow-primary mb-4 tracking-wider uppercase rounded-full">{cms(c, 'about_pmc_subhead', 'People Matter Culture')}</span>
        )}
        <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-5">{cms(c, 'about_pmc_headline', 'The PMC Way')}</h2>
        <p class="text-lg text-gray leading-relaxed border-l-4 border-yellow-primary pl-4">{cms(c, 'about_pmc_description', "People Matter Culture is how we run this company. PMC shapes how we work with clients, build systems, and measure success. It means integrity in our recommendations, practical creativity in our solutions, thought diversity in our approach, and Kingdom values at the foundation. Every system we touch has PMC built in.")}</p>
      </div>
    </div>
  </Section>

  <!-- Why YellowBrolly -->
  <Section background="sand" id="why-yellowbrolly">
    <div class="max-w-5xl">
      <span class="scroll-fade-up text-yellow-text text-sm font-semibold tracking-[0.2em] uppercase mb-4 block">{cms(c, 'about_why_eyebrow', 'Why YellowBrolly')}</span>
      <h2 class="scroll-fade-up text-3xl md:text-4xl lg:text-5xl font-display font-bold text-text-primary mb-8 leading-[1.1]">{cms(c, 'about_why_headline', 'One partner. Real progress.')}</h2>
      <div class="scroll-fade-up grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
        <div class="space-y-6">
          <p class="text-lg text-text-secondary leading-relaxed">
            {cms(c, 'about_why_p1', 'Most organizations do not need more advice in isolation. They need a partner who can connect the dots.')}
          </p>
          <p class="text-lg text-text-secondary leading-relaxed">
            {cms(c, 'about_why_p2', 'YellowBrolly brings together strategy, culture, digital readiness, brand, and implementation in one integrated model. That means less fragmentation, stronger alignment, and a clearer path from vision to execution.')}
          </p>
        </div>
        <div class="space-y-6">
          <p class="text-lg text-text-secondary leading-relaxed">
            {cms(c, 'about_why_p3', 'We help clients do the hard but necessary work of growth: making decisions, strengthening systems, aligning people, adopting tools, and building the confidence to move forward.')}
          </p>
          <p class="text-xl md:text-2xl font-display font-bold text-text-primary leading-snug mt-4">
            {cms(c, 'about_why_closing', 'Because the goal is not just change. The goal is lasting capability.')}
          </p>
        </div>
      </div>
    </div>
  </Section>

  <TeamSection client:visible />

  <CTASection client:visible headline={cms(c, 'about_cta', "Let's figure out what your team actually needs.")} primaryCta={{ label: cms(c, 'about_cta_button', "Let's Connect"), to: '/contact' }} />
</Base>
