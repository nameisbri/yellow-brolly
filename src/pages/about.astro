---
import Base from '../layouts/Base.astro';
import PageHero from '../components/astro/PageHero.astro';
import Section from '../components/astro/Section.astro';
import ValuesGrid from '../components/astro/ValuesGrid.astro';
import TeamSection from '../components/react/sections/TeamSection.tsx';
import CTASection from '../components/react/sections/CTASection.tsx';
import { siteContent } from '../data/content';

const { story, pmcWay, cta } = siteContent.about;
---

<Base
  title="About Us — Our Story & Team | YellowBrollyCo"
  description="Meet the YellowBrolly team. 30+ years combined in brand strategy, cybersecurity, and nonprofit technology consulting."
>
  <PageHero headline="Tech with soul. Strategy with impact." subhead="Helping people-first organizations do well in a digital world, without compromising on security, strategy, or staying power." eyebrow="About Us" />

  <Section background="dark">
    <div class="scroll-fade-up max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-6">{story.headline}</h2>
      <p class="text-lg text-gray leading-relaxed">{story.content}</p>
    </div>
  </Section>

  <ValuesGrid />

  <Section background="black">
    <div class="scroll-fade-up max-w-3xl">
      {pmcWay.subhead && (
        <span class="inline-block px-2 py-1 text-sm font-medium bg-dark-border text-light-gray mb-4 tracking-wider uppercase">{pmcWay.subhead}</span>
      )}
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-5">{pmcWay.headline}</h2>
      <p class="text-lg text-gray leading-relaxed border-l-4 border-yellow-primary pl-4">{pmcWay.description}</p>
    </div>
  </Section>

  <TeamSection client:visible />

  <CTASection client:visible headline={cta} primaryCta={{ label: "Let's Connect", to: '/contact' }} />
</Base>
