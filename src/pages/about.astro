---
import Base from '../layouts/Base.astro';
import PageHero from '../components/astro/PageHero.astro';
import Section from '../components/astro/Section.astro';
import ValuesGrid from '../components/astro/ValuesGrid.astro';
import TeamSection from '../components/react/sections/TeamSection.tsx';
import CTASection from '../components/react/sections/CTASection.tsx';
import { siteContent } from '../data/content';

const { story, pmcWay, cta } = siteContent.about;
---

<Base
  title="About Us: Our Story & Team | YellowBrollyCo"
  description="Meet the YellowBrolly team. We bring together strategy, culture, digital readiness, brand, and implementation to help organizations grow."
>
  <PageHero headline="Tech with soul. Strategy with impact." subhead="Helping people-first organizations do well in a digital world, without compromising on security, strategy, or staying power." eyebrow="About Us" />

  <!-- Story with full-width photo -->
  <Section background="sand">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="scroll-fade-up">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-text-primary mb-6">{story.headline}</h2>
        <p class="text-lg text-text-muted leading-relaxed">{story.content}</p>
      </div>
      <div class="scroll-fade-up relative">
        <img
          src="/images/photos/our-story-hero.jpg"
          alt="Small team collaborating around a table, seen through a glass partition"
          class="w-full rounded-2xl aspect-[4/3] object-cover"
          loading="lazy"
        />
        <img
          src="/images/brand/creative-designer.png"
          alt=""
          aria-hidden="true"
          class="absolute -bottom-12 -left-12 w-56 h-56 object-contain hidden lg:block"
          style="filter: drop-shadow(0 0 8px rgba(255,252,247,0.95)) drop-shadow(0 0 16px rgba(255,252,247,0.8)) drop-shadow(0 0 28px rgba(255,252,247,0.6))"
          loading="lazy"
        />
      </div>
    </div>
  </Section>

  <ValuesGrid />

  <!-- PMC Way with culture photo -->
  <Section background="warm">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="scroll-fade-up order-2 lg:order-1 relative">
        <img
          src="/images/photos/people-matter-culture.jpg"
          alt="Two colleagues walking together on a sunlit sidewalk sharing coffee"
          class="w-full rounded-2xl aspect-[4/3] object-cover"
          loading="lazy"
        />
        <img
          src="/images/brand/thumbs-up.png"
          alt=""
          aria-hidden="true"
          class="absolute -top-12 -right-12 w-52 h-52 object-contain hidden lg:block"
          style="filter: drop-shadow(0 0 8px rgba(255,252,247,0.95)) drop-shadow(0 0 16px rgba(255,252,247,0.8)) drop-shadow(0 0 28px rgba(255,252,247,0.6))"
          loading="lazy"
        />
      </div>
      <div class="scroll-fade-up order-1 lg:order-2">
        {pmcWay.subhead && (
          <span class="inline-block px-3 py-1 text-sm font-medium bg-yellow-primary/10 text-yellow-text mb-4 tracking-wider uppercase rounded-full">{pmcWay.subhead}</span>
        )}
        <h2 class="text-2xl md:text-3xl font-display font-bold text-text-primary mb-5">{pmcWay.headline}</h2>
        <p class="text-lg text-text-muted leading-relaxed border-l-4 border-yellow-primary pl-4">{pmcWay.description}</p>
      </div>
    </div>
  </Section>

  <TeamSection client:visible />

  <CTASection client:visible headline={cta} primaryCta={{ label: "Let's Connect", to: '/contact' }} />
</Base>
