---
import Base from '../layouts/Base.astro';
import HeroSection from '../components/react/HeroSection.tsx';
import WhoWeAre from '../components/astro/WhoWeAre.astro';
import ApproachPreview from '../components/react/sections/ApproachPreview.tsx';
import ServicesPreview from '../components/astro/ServicesPreview.astro';
import WorkPreview from '../components/astro/WorkPreview.astro';
import SocialProof from '../components/react/sections/SocialProof.tsx';
import CTASection from '../components/react/sections/CTASection.tsx';
import { getCMSContent, cms } from '../lib/cms';

const c = await getCMSContent();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Yellow Brolly Co",
    "url": "https://yellow-brolly.vercel.app",
    "logo": "https://yellow-brolly.vercel.app/umbrella.svg",
    "description": "We help organizations grow with clarity, confidence, and the systems to scale. Strategy, digital readiness, brand, funding, and implementation support.",
    "email": "team@yellowbrollyco.com",
    "founders": [
      { "@type": "Person", "name": "Jon Ferreira", "jobTitle": "Chief Executive Officer" },
      { "@type": "Person", "name": "Aimee Slater", "jobTitle": "Chief Growth Officer" },
      { "@type": "Person", "name": "Abbey Ferreira", "jobTitle": "Chief Marketing Officer" }
    ],
    "sameAs": [
      "https://www.linkedin.com/in/aimeelslater/",
      "https://www.linkedin.com/in/abbey-ferreira-92b1291b2/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Yellow Brolly Co",
    /* TODO: Update URL when migrating to Webflow Cloud domain */
    "url": "https://yellow-brolly.vercel.app"
  }
];
---

<Base
  title="Strategy, Digital & Implementation Consulting | YellowBrollyCo"
  description="We help organizations grow with clarity, confidence, and the systems to scale. Strategy, digital readiness, brand, culture, funding, and implementation support."
  jsonLd={jsonLd}
>
  <HeroSection client:visible
    headline={cms(c, 'hero_headline', 'When growth gets complex, we help you move forward.')}
    subheading={cms(c, 'hero_subheading', 'We help organizations strengthen leadership, modernize operations, and implement change that lasts.')}
    ctaText={cms(c, 'hero_cta', 'Book a Discovery Call')}
  />
  <WhoWeAre
    pmcHeadline={c['pmc_headline']}
    pmcSubheading={c['pmc_subheading']}
    pmcDescription={c['pmc_description']}
  />
  <ApproachPreview client:visible
    headline={cms(c, 'home_approach_headline', 'A clear, repeatable approach to lasting change.')}
  />
  <ServicesPreview />

  <!-- Brand Archetype callout — compact inline -->
  <section class="py-8 md:py-10 bg-cream">
    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
      <div class="scroll-fade-up flex flex-col sm:flex-row items-center justify-between gap-4 border border-light-border rounded-xl p-5 md:p-6 bg-white">
        <div class="flex items-center gap-4">
          <img src="/images/brand/magnifying-glass.webp" alt="" aria-hidden="true" class="w-12 h-12 object-contain flex-shrink-0" loading="lazy" />
          <div>
            <h3 class="text-base font-display font-bold text-text-primary">{cms(c, 'archetype_callout_heading', 'Curious what drives your brand?')}</h3>
            <p class="text-sm text-text-muted">{cms(c, 'archetype_callout_subhead', 'Take our Brand Archetype assessment.')}</p>
          </div>
        </div>
        <a href="/brand-archetype" class="flex-shrink-0 text-yellow-text hover:text-yellow-hover font-medium text-sm inline-flex items-center gap-2 transition-colors duration-300">
          {cms(c, 'archetype_callout_cta', 'Find Your Archetype')}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
      </div>
    </div>
  </section>

  <WorkPreview />
  <SocialProof client:visible
    headline={c['social_proof_headline']}
    clientCount={c['client_count']}
  />
  <CTASection client:visible
    headline={cms(c, 'cta_headline', "Let's build the clarity and momentum your organization needs.")}
    primaryCta={{ label: cms(c, 'cta_button', 'Book a Discovery Call'), to: '/contact' }}
  />
</Base>
