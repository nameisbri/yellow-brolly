---
import Base from '../layouts/Base.astro';
import PageHero from '../components/astro/PageHero.astro';
import Section from '../components/astro/Section.astro';
import { siteContent } from '../data/content';

const { blog } = siteContent;
---

<Base
  title="Insights & Ideas — Blog | YellowBrollyCo"
  description="Thoughts on technology, culture, and people-first strategy from the YellowBrolly team."
>
  <PageHero
    headline={blog.hero.headline}
    subhead={blog.hero.subhead}
    eyebrow="Blog"
  />

  <Section background="dark">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {blog.posts.map((post) => (
          <article class="scroll-fade-up bg-dark-elevated border border-dark-border p-6 group hover:border-dark-border/80 transition-colors duration-500">
            <span class="inline-block text-xs font-medium text-yellow-primary tracking-wider uppercase mb-3">
              {post.category}
            </span>
            <h3 class="text-lg font-display font-bold text-white mb-2 group-hover:text-yellow-primary transition-colors duration-300">
              {post.title}
            </h3>
            <p class="text-sm text-gray leading-relaxed mb-4">{post.excerpt}</p>
            <time class="text-xs text-gray">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </article>
        ))}
      </div>

      <div class="scroll-fade-up mt-16 text-center">
        <p class="text-gray text-sm">More articles coming soon. Stay tuned.</p>
      </div>
    </div>
  </Section>
</Base>
