---
import Base from '../layouts/Base.astro';
import PageHero from '../components/astro/PageHero.astro';
import Section from '../components/astro/Section.astro';
import CTASection from '../components/react/sections/CTASection.tsx';
---

<Base
  title="Why YellowBrolly: One Partner, Real Progress | YellowBrollyCo"
  description="YellowBrolly brings together strategy, culture, digital readiness, brand, and implementation in one integrated model. Less fragmentation, stronger alignment."
>
  <PageHero
    headline="One partner. Real progress."
    subhead="Most organizations do not need more advice in isolation. They need a partner who can connect the dots."
    eyebrow="Why YellowBrolly"
  />

  <Section background="sand">
    <div class="max-w-3xl mx-auto">
      <div class="scroll-fade-up space-y-6">
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
          YellowBrolly brings together strategy, culture, digital readiness, brand, and implementation in one integrated model. That means less fragmentation, stronger alignment, and a clearer path from vision to execution.
        </p>
        <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
          We help clients do the hard but necessary work of growth: making decisions, strengthening systems, aligning people, adopting tools, and building the confidence to move forward.
        </p>
        <p class="text-xl md:text-2xl font-display text-text-primary leading-relaxed mt-8">
          Because the goal is not just change. The goal is lasting capability.
        </p>
      </div>
    </div>
  </Section>

  <!-- Brand positioning nudge -->
  <Section background="cream">
    <div class="scroll-fade-up flex flex-col sm:flex-row items-center gap-6 max-w-3xl mx-auto">
      <img src="/images/brand/trophy-winner.png" alt="" aria-hidden="true" class="w-16 h-16 object-contain flex-shrink-0" loading="lazy" />
      <div>
        <p class="text-text-secondary leading-relaxed">
          Part of connecting the dots is understanding who your brand really is.
          <a href="/brand-archetype" class="text-yellow-text hover:text-yellow-hover font-medium inline-flex items-center gap-1 ml-1 transition-colors duration-300">
            Discover your brand archetype
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
          </a>
        </p>
      </div>
    </div>
  </Section>

  <CTASection client:visible
    headline="Let's build the clarity, systems, and momentum your organization needs to grow well."
    primaryCta={{ label: 'Talk to YellowBrolly', to: '/contact' }}
    secondaryCta={{ label: 'Explore Our Approach', to: '/approach' }}
  />
</Base>
