---
import Base from '../layouts/Base.astro';
import HeroF from '../components/react/hero-explorations/HeroF_SingleIllustration.tsx';
import HeroFG from '../components/react/hero-explorations/HeroFG_Combined.tsx';
import HeroG from '../components/react/hero-explorations/HeroG_IllustrationStack.tsx';
---

<Base
  title="Hero Exploration | YellowBrollyCo"
  description="Hero section design exploration"
>
  <div class="pt-28 pb-8 bg-cream">
    <div class="container mx-auto px-6 md:px-8 lg:px-12 max-w-7xl">
      <h1 class="text-2xl font-display font-bold text-text-primary mb-2">Hero Exploration — Final Round</h1>
      <p class="text-text-muted">F, F+G combined, G</p>
    </div>
  </div>

  <!-- F: Overlapping illustration -->
  <div class="border-t-4 border-yellow-primary">
    <div class="bg-sand py-4 px-6 md:px-8">
      <div class="container mx-auto max-w-7xl">
        <span class="text-xs font-bold uppercase tracking-widest text-yellow-text">F</span>
        <span class="text-sm text-text-muted ml-3">Overlapping — winged pencil breaks into the headline, 3D tilt on cursor</span>
      </div>
    </div>
    <HeroF client:visible />
  </div>

  <!-- FG: Combined — multiple illustrations overlapping editorial headline -->
  <div class="border-t-4 border-yellow-primary mt-4">
    <div class="bg-sand py-4 px-6 md:px-8">
      <div class="container mx-auto max-w-7xl">
        <span class="text-xs font-bold uppercase tracking-widest text-yellow-text">F+G</span>
        <span class="text-sm text-text-muted ml-3">Combined — 3 illustrations at different depths overlapping the headline, multi-layer parallax + 3D tilt</span>
      </div>
    </div>
    <HeroFG client:visible />
  </div>

  <!-- G: Illustration stack -->
  <div class="border-t-4 border-yellow-primary mt-4">
    <div class="bg-sand py-4 px-6 md:px-8">
      <div class="container mx-auto max-w-7xl">
        <span class="text-xs font-bold uppercase tracking-widest text-yellow-text">G</span>
        <span class="text-sm text-text-muted ml-3">Stack — 3 illustrations in frosted frames, slide in + mouse parallax</span>
      </div>
    </div>
    <HeroG client:visible />
  </div>

  <div class="py-20 bg-cream text-center">
    <p class="text-text-muted">End of hero exploration.</p>
  </div>
</Base>
